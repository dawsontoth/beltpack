{
  "name": "beltpack-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beltpack PWA for Android phones and booth laptops",
  "license": "ISC",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --outfile=dist/app.js",
    "watch": "esbuild src/app.js --bundle --format=esm --outfile=dist/app.js --watch",
    "serve": "python3 -m http.server 8080",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "livekit-client": "^2.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
