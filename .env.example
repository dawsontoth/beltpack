# Copy to .env and fill in. Never commit .env.
# Generate a key/secret pair with:  livekit-server generate-keys

LIVEKIT_URL="ws://127.0.0.1:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="CHANGE-ME-min-32-chars-long-secret"

# The booth Mac's LAN address on the comms VLAN. Phones connect their media
# straight here, bypassing Caddy, so a wrong value fails confusingly:
# signalling connects fine and audio never arrives.
BELTPACK_NODE_IP="192.168.10.10"

# Room every beltpack joins.
BELTPACK_ROOM="comms"

# Substring match against the Core Audio input device name.
# Run `make devices` to list what this Mac can see.
BELTPACK_INPUT_DEVICE="WING"

# Phase 2: let the bridge subscribe to phone mics so it can sum them
# back into the WING. Leave false for listen-only.
BELTPACK_SUBSCRIBE="false"

# Phase 2 only: where the summed phone audio goes back out. Point it at the
# WING channel feeding Bus 1 — never Bus 2, or phone users hear themselves
# a quarter-second late.
BELTPACK_OUTPUT_DEVICE=""

# Phase 2: let beltpacks publish. Tokens mint with canPublish false until
# this is true.
BELTPACK_CAN_PUBLISH="false"

# Shared passcode the token service requires before minting a token.
BELTPACK_PASSCODE="change-me"

# What a phone should be pointed at: the address serving /token. Used to build
# pairing codes, so volunteers never type this by hand. `setup.sh` fills it in.
BELTPACK_CLIENT_URL=""

# Gates the management page at http://<host>:7884. Kept separate from the join
# passcode on purpose: that one is printed on QR codes and handed round, while
# this one can re-patch what the console is capturing.
BELTPACK_ADMIN_PASSCODE="change-me"
BELTPACK_ADMIN_PORT="7884"
TOKEN_PORT="7883"

# Where the services listen. Loopback is right for production, where Caddy
# fronts everything. A LAN test with no TLS needs 0.0.0.0 on both.
BELTPACK_BIND="127.0.0.1"
TOKEN_BIND="127.0.0.1"
